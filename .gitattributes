# Git LFS tracking for large model files
models/fine_tuned/*.pth filter=lfs diff=lfs merge=lfs -text
models/fine_tuned/*.pt filter=lfs diff=lfs merge=lfs -text
models/pretrained/*.pth filter=lfs diff=lfs merge=lfs -text
models/pretrained/*.pt filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text

# Ensure text files are normalized
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.dockerignore text eol=lf